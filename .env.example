# ===================================================
# WebAuditAgent — Environment Configuration
# ===================================================
# Ushbu faylni .env deb nusxa oling va to'ldiring
# cp .env.example .env

# ----- Database -----
DATABASE_URL=sqlite+aiosqlite:///./audit.db

# ----- Anthropic Claude API (Report generation uchun) -----
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ----- Scanner Settings -----
# So'rovlar orasidagi kutish vaqti (soniyada) — Rate limiting
REQUEST_DELAY=0.5
# Maksimal parallel so'rovlar soni
MAX_CONCURRENT_REQUESTS=5
# So'rov timeout (soniyada)
REQUEST_TIMEOUT=10

# ----- Tool Paths (agar PATH da bo'lmasa) -----
NMAP_PATH=nmap
GOBUSTER_PATH=gobuster
FFUF_PATH=ffuf
WHATWEB_PATH=whatweb
AMASS_PATH=amass
SSLYZE_PATH=sslyze
WPSCAN_PATH=wpscan
NIKTO_PATH=nikto

# ----- App Settings -----
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
SECRET_KEY=change-this-to-random-secret-key
