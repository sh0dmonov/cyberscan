# ===================================================
# WebAuditAgent — Environment Configuration
# ===================================================
# Ushbu faylni .env deb nusxa oling va to'ldiring
# cp .env.example .env

# ----- Database -----
DATABASE_URL=sqlite+aiosqlite:///./audit.db

# ----- Anthropic Claude API (ixtiyoriy — hisobot boyitish uchun) -----
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ----- Scanner Settings -----
# So'rovlar orasidagi kutish vaqti (soniyada) — Rate limiting
REQUEST_DELAY=0.5
# Maksimal parallel so'rovlar soni (asyncio.Semaphore orqali cheklanadi)
MAX_CONCURRENT_REQUESTS=5
# So'rov timeout (soniyada)
REQUEST_TIMEOUT=10
# SSL sertifikat tekshiruvi (False — expired cert bo'lgan saytlarni ham skanerlash uchun)
VERIFY_SSL=false

# ----- Tool Paths (agar PATH da bo'lmasa) -----
NMAP_PATH=nmap
SSLYZE_PATH=sslyze

# ----- App Settings -----
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
# MUHIM: Ishlab chiqarish rejimida bu qiymatni o'zgartiring!
SECRET_KEY=change-this-to-random-secret-key

# ----- Web UI Authentication -----
# AUTH_ENABLED=false qilib o'chirish mumkin (faqat ishlab chiqarish da!!)
AUTH_ENABLED=true
AUTH_USERNAME=admin
# MUHIM: Ishlab chiqarish rejimida kuchli parol o'rnating!
AUTH_PASSWORD=changeme
